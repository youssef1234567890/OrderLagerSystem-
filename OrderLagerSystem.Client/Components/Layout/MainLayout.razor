@inherits LayoutComponentBase
@inject StockMovementApiService StockMovementApi

<div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main>
        <div class="top-row px-4">
            <a href="https://learn.microsoft.com/aspnet/core/" target="_blank">About</a>
            <span class="ms-3">|</span>
            <span class="ms-3">Lagerstatus: <strong>@stockBalance</strong></span>
            <span class="ms-3">|</span>
            <span class="ms-3">Aktiv lagringsplats: <strong>@activeStorageLocation</strong></span>
        </div>

        <article class="content px-4">
            @Body
        </article>
    </main>
</div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    private int stockBalance = 0;
    private string activeStorageLocation = "Ej vald";

    protected override async Task OnInitializedAsync()
    {
        try
        {
            stockBalance = await StockMovementApi.GetStockBalanceAsync(articleId: 1); // Example articleId
            activeStorageLocation = "Lager A"; // Example storage location
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine($"Error loading stock balance: {ex.Message}");
        }
    }
}
