@using OrderLagerSystem.Api.DTOs
@using OrderLagerSystem.Client.Services
@inject StockMovementApiService StockMovementApi
@inject ILogger<PurchaseOrderList> Logger

<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h5 class="mb-0">Alla inköpsorder</h5>
        <div class="btn-group" role="group">
            <button class="btn @(filterStatus == "All" ? "btn-primary" : "btn-outline-primary") btn-sm" 
                    @onclick="SetFilterAll">
                Alla
            </button>
            <button class="btn @(filterStatus == "Pending" ? "btn-warning" : "btn-outline-warning") btn-sm" 
                    @onclick="SetFilterPending">
                Väntande
            </button>
            <button class="btn @(filterStatus == "Received" ? "btn-success" : "btn-outline-success") btn-sm" 
                    @onclick="SetFilterReceived">
                Inleverade
            </button>
        </div>
    </div>
    <div class="card-body">
        @if (isLoading)
        {
            <div class="text-center">
                <div class="spinner-border" role="status">
                    <span class="visually-hidden">Laddar...</span>
                </div>
            </div>
        }
        else if (filteredOrders?.Any() == true)
        {
            <div class="table-responsive">
                <table class="table table-striped">
                    <thead>
                        <tr>
                            <th>Ordrenummer</th>
                            <th>Artikel</th>
                            <th>SKU</th>
                            <th>Antal</th>
                            <th>Orderdatum</th>
                            <th>Leverantör</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var order in filteredOrders)
                        {
                            <tr>
                                <td>@order.OrderNumber</td>
                                <td>@order.Article?.Name</td>
                                <td>@order.Article?.Sku</td>
                                <td>@order.OrderedQuantity</td>
                                <td>@order.OrderDate.ToString("yyyy-MM-dd")</td>
                                <td>@order.SupplierName</td>
                                <td>
                                    @if (order.Status == "Pending")
                                    {
                                        <span class="badge bg-warning">
                                            Väntande
                                        </span>
                                    }
                                    else if (order.Status == "Received")
                                    {
                                        <span class="badge bg-success">
                                            Inleverad
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">
                                            @order.Status
                                        </span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="text-center text-muted">
                <p>Inga inköpsorder hittades för vald filter.</p>
            </div>
        }
    </div>
</div>

@code {
    private List<PendingPurchaseOrder>? allOrders = new List<PendingPurchaseOrder>();
    private List<PendingPurchaseOrder>? filteredOrders = new List<PendingPurchaseOrder>();
    private bool isLoading = false;
    private string filterStatus = "All";

    protected override async Task OnInitializedAsync()
    {
        await LoadAllOrders();
    }

    private async Task LoadAllOrders()
    {
        isLoading = true;
        try
        {
            allOrders = await StockMovementApi.GetPurchaseOrdersAsync();
            ApplyFilter();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading purchase orders");
            allOrders = new List<PendingPurchaseOrder>();
            filteredOrders = new List<PendingPurchaseOrder>();
        }
        finally
        {
            isLoading = false;
        }
    }

    private void SetFilterAll()
    {
        filterStatus = "All";
        ApplyFilter();
    }

    private void SetFilterPending()
    {
        filterStatus = "Pending";
        ApplyFilter();
    }

    private void SetFilterReceived()
    {
        filterStatus = "Received";
        ApplyFilter();
    }

    private void ApplyFilter()
    {
        if (allOrders == null)
        {
            filteredOrders = new List<PendingPurchaseOrder>();
            return;
        }

        filteredOrders = filterStatus switch
        {
            "Pending" => allOrders.Where(o => o.Status == "Pending").ToList(),
            "Received" => allOrders.Where(o => o.Status == "Received").ToList(),
            _ => allOrders.ToList()
        };
    }

    private async Task RefreshOrders()
    {
        await LoadAllOrders();
        StateHasChanged();
    }
}