@page "/order-history"
@using OrderLagerSystem.Client.Services
@inject OrderApiService OrderApi
@inject ILogger<OrderHistory> Logger
@rendermode InteractiveServer

<PageTitle>Orderhistorik</PageTitle>

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h1>Orderhistorik</h1>
            <p class="text-muted">Senaste statusändringar för order</p>
        </div>
        <div class="d-flex gap-2">
            <input class="form-control" style="width: 220px" placeholder="Filtrera på Order ID"
                   @bind="orderIdFilterText" @bind:event="oninput" />
            <button class="btn btn-outline-secondary" @onclick="Reload" disabled="@isLoading">
                @(isLoading ? "Laddar..." : "Uppdatera")
            </button>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(message))
    {
        <div class="alert @alertClass">@message</div>
    }

    @if (isLoading)
    {
        <div class="text-center my-5">
            <div class="spinner-border" role="status"><span class="visually-hidden">Laddar...</span></div>
        </div>
    }
    else if (entries?.Any() == true)
    {
        <div class="table-responsive">
            <table class="table table-striped align-middle">
                <thead>
                    <tr>
                        <th>Order ID</th>
                        <th>Tid</th>
                        <th>Från</th>
                        <th>Till</th>
                        <th>Användare</th>
                        <th>Kommentar</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var h in entries!)
                    {
                        <tr class="@RowClass(h.NewStatus)">
                            <td>@h.OrderId</td>
                            <td>@h.ChangedUtc.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</td>
                            <td>@(string.IsNullOrWhiteSpace(h.OldStatus) ? "-" : h.OldStatus)</td>
                            <td>@h.NewStatus</td>
                            <td>@(string.IsNullOrWhiteSpace(h.ChangedByUserId) ? "-" : h.ChangedByUserId)</td>
                            <td>@(string.IsNullOrWhiteSpace(h.Comment) ? "-" : h.Comment)</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="text-muted">Ingen historik hittades.</div>
    }
</div>

@code {
    private bool isLoading = true;
    private string message = "";
    private string alertClass = "alert-info";
    private string orderIdFilterText = "";
    private List<OrderHistoryDto>? entries;

    protected override async Task OnInitializedAsync()
    {
        await Load();
    }

    private async Task Load()
    {
        isLoading = true;
        message = "";
        try
        {
            int? orderId = null;
            if (int.TryParse(orderIdFilterText, out var parsed) && parsed > 0)
                orderId = parsed;

            entries = await OrderApi.GetOrderHistoryAsync(orderId);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to load order history");
            message = "Kunde inte hämta orderhistorik.";
            alertClass = "alert-danger";
            entries = new();
        }
        finally
        {
            isLoading = false;
        }
    }

    private Task Reload() => Load();

    private string RowClass(string status) => status switch
    {
        "Created" => "",
        "Confirmed" => "table-success",
        "Shipped" => "table-info",
        "Delivered" => "table-secondary",
        "Cancelled" => "table-danger",
        _ => ""
    };
}