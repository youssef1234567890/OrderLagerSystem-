@page "/delivery-orders"
@using OrderLagerSystem.Api.DTOs
@using OrderLagerSystem.Client.Services
@inject OrderApiService OrderApi
@inject ILogger<DeliverOrders> Logger
@inject OrderLagerSystem.Client.Services.AuthService AuthService
@inject NavigationManager Navigation
@rendermode InteractiveServer

<PageTitle>Utleverans</PageTitle>

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h1>Utleverans</h1>
            <p class="text-muted">Hantera order som väntar på leverans</p>
        </div>
        <div class="d-flex gap-2">
            <button class="btn btn-outline-secondary" @onclick="Reload" disabled="@isLoading">
                @(isLoading ? "Laddar..." : "Uppdatera")
            </button>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(message))
    {
        <div class="alert @alertClass">@message</div>
    }

    @if (isLoading)
    {
        <div class="text-center my-5">
            <div class="spinner-border" role="status">
                <span class="visually-hidden">Laddar...</span>
            </div>
        </div>
    }
    else if (orders?.Any() == true)
    {
        <div class="row">
            @foreach (var order in orders)
            {
                <div class="col-md-6 col-lg-4 mb-4">
                    <div class="card h-100">
                        <div class="card-header d-flex justify-content-between align-items-center">
                            <h6 class="mb-0">Order #@order.OrderId</h6>
                            <span class="badge @GetStatusBadgeClass(order.Status)">
                                @GetStatusText(order.Status)
                            </span>
                        </div>
                        <div class="card-body">
                            @if (!string.IsNullOrEmpty(order.ExternalOrderNo))
                            {
                                <p class="small text-muted mb-2">Externt nr: @order.ExternalOrderNo</p>
                            }
                            
                            <div class="mb-3">
                                <strong>Artiklar:</strong>
                                <ul class="list-unstyled mt-1">
                                    @foreach (var item in order.Items)
                                    {
                                        <li class="small">
                                            <span class="fw-semibold">@item.ArticleName</span>
                                            <span class="text-muted">(@item.ArticleSku)</span>
                                            <span class="badge bg-light text-dark ms-1">@item.Quantity st</span>
                                        </li>
                                    }
                                </ul>
                            </div>

                            <div class="row text-center mb-3">
                                <div class="col-6">
                                    <div class="small text-muted">Totalt antal</div>
                                    <div class="fw-bold">@order.TotalQuantity st</div>
                                </div>
                                <div class="col-6">
                                    <div class="small text-muted">Totalpris</div>
                                    <div class="fw-bold">@order.TotalPrice.ToString("0.00") kr</div>
                                </div>
                            </div>

                            <div class="small text-muted mb-3">
                                Skapad: @order.CreatedUtc.ToLocalTime().ToString("yyyy-MM-dd HH:mm")
                            </div>

                            @if (!string.IsNullOrEmpty(order.Notes))
                            {
                                <div class="small text-muted mb-3">
                                    <strong>Anteckningar:</strong><br>
                                    @order.Notes
                                </div>
                            }
                        </div>
                        <div class="card-footer">
                            <div class="d-grid gap-2">
                                @if (CanDeliverOrder(order))
                                {
                                    <button class="btn btn-success btn-sm" 
                                            @onclick="() => ShowDeliverModal(order)"
                                            disabled="@isDelivering">
                                        <i class="bi bi-truck"></i> Leverera order
                                    </button>
                                }
                                else
                                {
                                    <button class="btn btn-outline-secondary btn-sm" disabled>
                                        @GetCannotDeliverReason(order)
                                    </button>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="text-center text-muted">
            <div class="py-5">
                <i class="bi bi-inbox display-1"></i>
                <h4 class="mt-3">Inga order väntar på leverans</h4>
                <p>Alla order har levererats eller är avbrutna.</p>
            </div>
        </div>
    }
</div>

<!-- Deliver Order Modal -->
@if (selectedOrder != null)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Leverera order #@selectedOrder.OrderId</h5>
                    <button type="button" class="btn-close" @onclick="CloseDeliverModal"></button>
                </div>
                <div class="modal-body">
                    <div class="alert alert-info">
                        <strong>Varning:</strong> Detta kommer att minska lagersaldot för alla artiklar i ordern.
                    </div>
                    
                    <div class="mb-3">
                        <label class="form-label">Kommentar (valfritt)</label>
                        <textarea class="form-control" rows="3" @bind="deliveryComment" 
                                  placeholder="Lägg till en kommentar om leveransen..."></textarea>
                    </div>

                    <div class="mb-3">
                        <strong>Artiklar som kommer att levereras:</strong>
                        <ul class="list-unstyled mt-2">
                            @foreach (var item in selectedOrder.Items)
                            {
                                <li class="small">
                                    <span class="fw-semibold">@item.ArticleName</span>
                                    <span class="text-muted">(@item.ArticleSku)</span>
                                    <span class="badge bg-warning text-dark ms-1">-@item.Quantity st</span>
                                </li>
                            }
                        </ul>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="CloseDeliverModal">
                        Avbryt
                    </button>
                    <button type="button" class="btn btn-success" @onclick="DeliverOrder" disabled="@isDelivering">
                        @(isDelivering ? "Levererar..." : "Bekräfta leverans")
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private List<OrderResponse>? orders;
    private bool isLoading = true;
    private bool isDelivering = false;
    private string message = "";
    private string alertClass = "alert-info";
    private OrderResponse? selectedOrder;
    private string deliveryComment = "";

    protected override async Task OnInitializedAsync()
    {
        // Access control: only Admin and Orderkoordinator
        if (!AuthService.IsAuthenticated)
        {
            Navigation.NavigateTo("/login");
            return;
        }
        var roles = AuthService.CurrentUser?.Roles ?? new List<string>();
        if (!roles.Contains("Admin") && !roles.Contains("Orderkoordinator"))
        {
            Navigation.NavigateTo("/");
            return;
        }
        await Load();
    }

    private async Task Load()
    {
        isLoading = true;
        message = "";
        try
        {
            orders = await OrderApi.GetPendingDeliveryOrdersAsync() ?? new();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to load pending delivery orders");
            message = "Kunde inte hämta order som väntar på leverans.";
            alertClass = "alert-danger";
            orders = new();
        }
        finally
        {
            isLoading = false;
        }
    }

    private Task Reload() => Load();

    private bool CanDeliverOrder(OrderResponse order)
    {
        return order.Status == "Created";
    }

    private string GetCannotDeliverReason(OrderResponse order)
    {
        return order.Status switch
        {
            "Delivered" => "Redan levererad",
            _ => "Kan inte levereras"
        };
    }

    private string GetStatusBadgeClass(string status)
    {
        return status switch
        {
            "Created" => "bg-secondary",
            "Delivered" => "bg-success",
            _ => "bg-secondary"
        };
    }

    private string GetStatusText(string status)
    {
        return status switch
        {
            "Created" => "Skapad",
            "Delivered" => "Levererad",
            _ => status
        };
    }

    private void ShowDeliverModal(OrderResponse order)
    {
        selectedOrder = order;
        deliveryComment = "";
    }

    private void CloseDeliverModal()
    {
        selectedOrder = null;
        deliveryComment = "";
    }

    private async Task DeliverOrder()
    {
        if (selectedOrder == null) return;

        isDelivering = true;
        message = "";
        try
        {
            var success = await OrderApi.DeliverOrderAsync(selectedOrder.OrderId, deliveryComment);
            if (success)
            {
                message = $"Order #{selectedOrder.OrderId} har levererats framgångsrikt.";
                alertClass = "alert-success";
                CloseDeliverModal();
                await Load(); // Reload the list
            }
            else
            {
                alertClass = "alert-danger";
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to deliver order {OrderId}", selectedOrder.OrderId);
            alertClass = "alert-danger";
        }
        finally
        {
            isDelivering = false;
            StateHasChanged();
        }
    }
}
