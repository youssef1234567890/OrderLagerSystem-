@page "/profile"
@layout MainLayout
@using System.Text.Json
@using OrderLagerSystem.Client.Services
@using OrderLagerSystem.Api.DTOs
@inject NavigationManager Navigation
@inject OrderLagerSystem.Client.Services.AuthService AuthService
@rendermode InteractiveServer 

<PageTitle>My Profile - OrderLagerSystem</PageTitle>

<div class="container-fluid py-4">
    <div class="row">
        <div class="col-lg-8 mx-auto">
            
            @if (AuthService.IsAuthenticated && AuthService.CurrentUser != null)
            {
                <div class="card shadow">
                    <div class="card-header bg-primary text-white">
                        <h3 class="mb-0">
                            My Profile
                        </h3>
                    </div>
                    <div class="card-body">
                        <div class="row">
                            <div class="col-md-4 text-center">
                                <div class="mb-3">
                                    <div class="bg-primary text-white rounded-circle d-inline-flex align-items-center justify-content-center" style="width: 120px; height: 120px; font-size: 3rem;">
                                        @AuthService.CurrentUser.FullName?.Substring(0, 1).ToUpper()
                                    </div>
                                </div>
                                <h4>@AuthService.CurrentUser.FullName</h4>
                                <p class="text-muted">@string.Join(", ", AuthService.CurrentUser.Roles)</p>
                            </div>
                            <div class="col-md-8">
                                <h5>User Information</h5>
                                <hr>
                                
                                <div class="row mb-3">
                                    <div class="col-sm-4">
                                        <strong>User ID:</strong>
                                    </div>
                                    <div class="col-sm-8">
                                        <code>@AuthService.CurrentUser.Id</code>
                                    </div>
                                </div>
                                
                                <div class="row mb-3">
                                    <div class="col-sm-4">
                                        <strong>Username:</strong>
                                    </div>
                                    <div class="col-sm-8">
                                        @AuthService.CurrentUser.UserName
                                    </div>
                                </div>
                                
                                <div class="row mb-3">
                                    <div class="col-sm-4">
                                        <strong>Email:</strong>
                                    </div>
                                    <div class="col-sm-8">
                                        @AuthService.CurrentUser.Email
                                    </div>
                                </div>
                                
                                <div class="row mb-3">
                                    <div class="col-sm-4">
                                        <strong>Roles:</strong>
                                    </div>
                                    <div class="col-sm-8">
                                        @foreach (var role in AuthService.CurrentUser.Roles)
                                        {
                                            <span class="badge bg-secondary me-1">@role</span>
                                        }
                                    </div>
                                </div>
                                
                                @if (!string.IsNullOrEmpty(AuthService.AuthToken))
                                {
                                    <div class="row mb-3">
                                        <div class="col-sm-4">
                                            <strong>Token Status:</strong>
                                        </div>
                                        <div class="col-sm-8">
                                            <span class="badge bg-success">
                                                Active
                                            </span>
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                    <div class="card-footer">
                        <button class="btn btn-outline-danger" @onclick="Logout">
                            Logout
                        </button>
                        <button class="btn btn-outline-primary ms-2" @onclick="NavigateToHome">
                            Home
                        </button>
                    </div>
                </div>
            }
            else
            {
                <div class="card shadow">
                    <div class="card-body text-center py-5">
                        <div class="bg-secondary text-white rounded-circle d-inline-flex align-items-center justify-content-center mb-3" style="width: 120px; height: 120px; font-size: 3rem;">
                            ?
                        </div>
                        <h4>You are not logged in</h4>
                        <p class="text-muted mb-4">You must log in to view your profile.</p>
                        <a href="/login" class="btn btn-primary">
                            Login
                        </a>
                    </div>
                </div>
            }
            
        </div>
    </div>
</div>

@code {
    // No need for own variables - using AuthService directly

    /// <summary>
    /// Navigates to the home page
    /// </summary>
    private void NavigateToHome()
    {
        Console.WriteLine("Navigating to home page...");
        Navigation.NavigateTo("/");
    }

    /// <summary>
    /// Logs out the user and navigates to the login page
    /// </summary>
    private void Logout()
    {
        Console.WriteLine("Logging out user...");
        
        // Use AuthService for logout
        AuthService.Logout();
        
        // Update UI and navigate
        StateHasChanged();
        
        Console.WriteLine("Navigating to login page...");
        Navigation.NavigateTo("/login");
    }

}