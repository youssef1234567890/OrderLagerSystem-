@page "/articles"
@using OrderLagerSystem.Client.DTOs
@using OrderLagerSystem.Client.Services
@using ClientDto = OrderLagerSystem.Client.DTOs
@inject IArticleService ArticleService
@inject IBarcodeService BarcodeService
@inject AuthService AuthService
@rendermode InteractiveServer
@inject NavigationManager NavManager
@inject NavigationManager Navigation

<PageTitle>Artiklar</PageTitle>

<h3>Artikelhantering</h3>

@if (!AuthService.IsAuthenticated)
{
    <div class="alert alert-warning">
        <p>Du måste vara inloggad för att se artiklar.</p>
    </div>
}
else
{
    <div class="row mb-3">
        <div class="col-md-8">
            <input type="text" class="form-control" placeholder="Sök artiklar..."
                   @bind="searchTerm" @onkeyup="SearchArticles" />
        </div>
        <div class="col-md-4">
            @if (AuthService.CurrentUser?.Roles?.Contains("Admin") == true || 
                 AuthService.CurrentUser?.Roles?.Contains("Orderkoordinator") == true)
            {
                <button class="btn btn-primary" @onclick="ShowCreateForm">
                    <i class="bi bi-plus"></i> Ny artikel
                </button>
            }
        </div>
    </div>

    @if (isLoading)
    {
        <div class="d-flex justify-content-center">
            <div class="spinner-border" role="status">
                <span class="visually-hidden">Laddar...</span>
            </div>
        </div>
    }
    else if (articles != null && articles.Any())
    {
        <div class="row">
            @foreach (ClientDto.ArticleDto article in articles)
            {
                <div class="col-md-6 col-lg-4 mb-3">
                    <div class="card @(article.IsLowStock ? "border-warning" : "")">
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-start">
                                <h5 class="card-title">@article.Name</h5>
                                @if (!article.IsActive)
                                {
                                    <span class="badge bg-secondary">Inaktiv</span>
                                }
                                else if (article.IsLowStock)
                                {
                                    <span class="badge bg-warning">Lågt lager</span>
                                }
                            </div>
                            
                            <p class="card-text">
                                <small class="text-muted">SKU: @article.Sku</small><br/>
                                @if (!string.IsNullOrEmpty(article.Description))
                                {
                                    <span>@article.Description</span>
                                }
                            </p>
                            
                            <div class="row text-center">
                                <div class="col">
                                    <strong>@article.Price.ToString("C")</strong><br/>
                                    <small class="text-muted">Pris</small>
                                </div>
                                <div class="col">
                                    <strong>@article.StockQuantity</strong><br/>
                                    <small class="text-muted">I lager</small>
                                </div>
                                <div class="col">
                                    <strong>@article.MinimumStock</strong><br/>
                                    <small class="text-muted">Min. lager</small>
                                </div>
                            </div>
                            
                            @if (!string.IsNullOrEmpty(article.StorageLocation))
                            {
                                <div class="mt-2">
                                    <small><i class="bi bi-geo-alt"></i> @article.StorageLocation</small>
                                </div>
                            }
                            
                            <div class="mt-3">

                                <button class="btn btn-sm btn-outline-info ms-1" @onclick="() => ShowBarcode(article.ArticleId, article.Sku)">
                                    <i class="bi bi-upc-scan"></i> Streckkod
                                </button>
                                @if (CanEdit())
                                {
                                    <button class="btn btn-sm btn-outline-secondary ms-1" @onclick="() => EditArticle(article.ArticleId)">
                                        Redigera
                                    </button>
                                }
                                @if (CanDelete())
                                {
                                    <button class="btn btn-sm btn-outline-danger ms-1" @onclick="() => DeleteArticle(article.ArticleId, article.Name)">
                                        Ta bort
                                    </button>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else if (!isLoading)
    {
        <div class="alert alert-info">
            <p>Inga artiklar hittades.</p>
        </div>
    }

    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="alert alert-danger mt-3">
            @errorMessage
        </div>
    }

    @if (!string.IsNullOrEmpty(successMessage))
    {
        <div class="alert alert-success mt-3">
            @successMessage
        </div>
    }
    
    <!-- Barcode Modal -->
    @if (showBarcodeModal)
    {
        <div class="modal fade show d-block" tabindex="-1" style="background: rgba(0,0,0,0.5);">
            <div class="modal-dialog modal-lg">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title">Streckkod för @selectedArticleSku</h5>
                        <button type="button" class="btn-close" @onclick="CloseBarcodeModal"></button>
                    </div>
                    <div class="modal-body text-center">
                        @if (isGeneratingBarcode)
                        {
                            <div class="spinner-border" role="status">
                                <span class="visually-hidden">Genererar streckkod...</span>
                            </div>
                            <p class="mt-2">Genererar streckkod...</p>
                        }
                        else if (currentBarcode != null)
                        {
                            <div class="mb-3">
                                <label class="form-label">Format:</label>
                                <select class="form-select" value="@selectedBarcodeFormat" @onchange="RegenerateBarcode">
                                    <option value="@ClientDto.BarcodeFormat.Code128">Code 128 (Rekommenderat)</option>
                                    <option value="@ClientDto.BarcodeFormat.Code39">Code 39</option>
                                    <option value="@ClientDto.BarcodeFormat.QRCode">QR Code</option>
                                </select>
                            </div>
                            
                            <div class="barcode-container p-3" style="background: white; border: 1px solid #ddd; border-radius: 5px; display: inline-block;">
                                <img src="data:@currentBarcode.ContentType;base64,@currentBarcode.ImageBase64" 
                                     alt="Streckkod för @selectedArticleSku" 
                                     class="img-fluid" 
                                     style="max-width: 100%; height: auto;" />
                            </div>
                            
                            <div class="mt-3">
                                <small class="text-muted">
                                    Format: @currentBarcode.Format | 
                                    Genererad: @currentBarcode.GeneratedAt.ToString("yyyy-MM-dd HH:mm")
                                </small>
                            </div>
                            
                            <div class="mt-3">
                                <button class="btn btn-primary" @onclick="DownloadBarcode">
                                    <i class="bi bi-download"></i> Ladda ner PNG
                                </button>
                                <button class="btn btn-outline-secondary ms-2" @onclick="PrintBarcode">
                                    <i class="bi bi-printer"></i> Skriv ut
                                </button>
                            </div>
                        }
                        else if (!string.IsNullOrEmpty(barcodeError))
                        {
                            <div class="alert alert-danger">
                                @barcodeError
                            </div>
                            <button class="btn btn-primary" @onclick="() => ShowBarcode(selectedArticleId, selectedArticleSku)">
                                Försök igen
                            </button>
                        }
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" @onclick="CloseBarcodeModal">Stäng</button>
                    </div>
                </div>
            </div>
        </div>
    }
}

@code {
    private List<ClientDto.ArticleDto>? articles;
    private string searchTerm = string.Empty;
    private bool isLoading = true;
    private string errorMessage = string.Empty;
    private string successMessage = string.Empty;
    
    // Barcode modal state
    private bool showBarcodeModal = false;
    private bool isGeneratingBarcode = false;
    private ClientDto.BarcodeResponse? currentBarcode = null;
    private string selectedArticleSku = string.Empty;
    private int selectedArticleId = 0;
    private ClientDto.BarcodeFormat selectedBarcodeFormat = ClientDto.BarcodeFormat.Code128;
    private string barcodeError = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        await LoadArticles();
    }

    private async Task LoadArticles()
    {
        try
        {
            isLoading = true;
            errorMessage = string.Empty;
            
            // Admin kan se inaktiva artiklar
            bool includeInactive = AuthService.CurrentUser?.Roles?.Contains("Admin") == true;
            articles = await ArticleService.GetArticlesAsync(includeInactive);
            
            if (articles == null)
            {
                errorMessage = "Kunde inte ladda artiklar. Försök igen senare.";
            }
        }
        catch (UnauthorizedAccessException ex)
        {
            errorMessage = ex.Message;
        }
        catch (Exception ex)
        {
            errorMessage = $"Ett fel inträffade: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task SearchArticles()
    {
        if (string.IsNullOrWhiteSpace(searchTerm))
        {
            await LoadArticles();
            return;
        }

        try
        {
            isLoading = true;
            errorMessage = string.Empty;
            
            articles = await ArticleService.SearchArticlesAsync(searchTerm);
        }
        catch (Exception ex)
        {
            errorMessage = $"Sökfel: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

private void ShowCreateForm()
{
    Navigation.NavigateTo("/create");
}

private void EditArticle(int articleId)
{
    Navigation.NavigateTo($"/edit/{articleId}");
}



    private async Task DeleteArticle(int articleId, string articleName)
    {
        if (!CanDelete()) return;

        // Simple confirmation - in real app, use modal
        var confirmed = await Task.FromResult(true); // TODO: Add proper confirmation dialog
        
        if (!confirmed) return;

        try
        {
            var success = await ArticleService.DeleteArticleAsync(articleId);
            if (success)
            {
                successMessage = $"Artikel '{articleName}' har tagits bort.";
                await LoadArticles(); // Reload list
            }
            else
            {
                errorMessage = "Kunde inte ta bort artikeln.";
            }
        }
        catch (InvalidOperationException ex)
        {
            errorMessage = ex.Message;
        }
        catch (UnauthorizedAccessException ex)
        {
            errorMessage = ex.Message;
        }
    }

    private bool CanEdit()
    {
        return AuthService.CurrentUser?.Roles?.Any(r => r == "Admin" || r == "Orderkoordinator") == true;
    }

    private bool CanDelete()
    {
        return AuthService.CurrentUser?.Roles?.Contains("Admin") == true;
    }
    
    // Barcode methods
    private async Task ShowBarcode(int articleId, string sku)
    {
        selectedArticleId = articleId;
        selectedArticleSku = sku;
        selectedBarcodeFormat = ClientDto.BarcodeFormat.Code128;
        currentBarcode = null;
        barcodeError = string.Empty;
        showBarcodeModal = true;
        
        await GenerateCurrentBarcode();
    }
    
    private async Task GenerateCurrentBarcode()
    {
        try
        {
            isGeneratingBarcode = true;
            barcodeError = string.Empty;
            StateHasChanged();
            
            currentBarcode = await BarcodeService.GenerateArticleBarcodeAsync(
                selectedArticleId, 
                selectedBarcodeFormat, 
                300, 
                100, 
                true);
                
            if (currentBarcode == null)
            {
                barcodeError = "Kunde inte generera streckkod. Försök igen.";
            }
        }
        catch (InvalidOperationException ex)
        {
            barcodeError = ex.Message;
        }
        catch (UnauthorizedAccessException ex)
        {
            barcodeError = ex.Message;
        }
        catch (Exception ex)
        {
            barcodeError = $"Ett oväntat fel inträffade: {ex.Message}";
        }
        finally
        {
            isGeneratingBarcode = false;
            StateHasChanged();
        }
    }
    
    private async Task RegenerateBarcode(ChangeEventArgs e)
    {
        if (Enum.TryParse<ClientDto.BarcodeFormat>(e.Value?.ToString(), out var newFormat))
        {
            selectedBarcodeFormat = newFormat;
            await GenerateCurrentBarcode();
        }
    }
    
    private void CloseBarcodeModal()
    {
        showBarcodeModal = false;
        currentBarcode = null;
        barcodeError = string.Empty;
        selectedArticleSku = string.Empty;
        selectedArticleId = 0;
    }
    
    private async Task DownloadBarcode()
    {
        if (currentBarcode == null) return;
        
        try
        {
            var imageBytes = Convert.FromBase64String(currentBarcode.ImageBase64);
            var fileName = $"{selectedArticleSku}-barcode-{currentBarcode.Format}.png";
            
            // Skulle normalt göras via JS interop
            await Task.Run(() => 
            {
                successMessage = $"Streckkod för {selectedArticleSku} är redo för nedladdning. Högerklicka på bilden och välj 'Spara bild som...'";
            });
        }
        catch (Exception ex)
        {
            barcodeError = $"Kunde inte ladda ner streckkod: {ex.Message}";
        }
    }
    
    private async Task PrintBarcode()
    {
        if (currentBarcode == null) return;
        
        try
        {
            // Skulle normalt göras via JS interop
            await Task.Run(() => 
            {
                successMessage = $"För att skriva ut: Högerklicka på streckkodsbilden och välj 'Skriv ut bild' eller kopiera bilden till ett ordbehandlingsprogram.";
            });
        }
        catch (Exception ex)
        {
            barcodeError = $"Kunde inte skriva ut streckkod: {ex.Message}";
        }
    }
}
