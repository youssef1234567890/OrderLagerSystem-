@page "/create"
@rendermode InteractiveServer
@using OrderLagerSystem.Client.DTOs
@using OrderLagerSystem.Client.Services
@inject IArticleService ArticleService
@inject NavigationManager Navigation
@inject AuthService AuthService

<PageTitle>Skapa ny artikel</PageTitle>

<h3>Skapa ny artikel</h3>

<EditForm Model="newArticle" OnValidSubmit="SaveArticle" FormName="CreateArticleForm">
    <DataAnnotationsValidator />
    <ValidationSummary class="text-danger" />

    <div class="mb-3">
        <label class="form-label">SKU</label>
        <InputText class="form-control" @bind-Value="newArticle.Sku" />
        <ValidationMessage For="@(() => newArticle.Sku)" class="text-danger" />
    </div>

    <div class="mb-3">
        <label class="form-label">Namn</label>
        <InputText class="form-control" @bind-Value="newArticle.Name" />
        <ValidationMessage For="@(() => newArticle.Name)" class="text-danger" />
    </div>

    <div class="mb-3">
        <label class="form-label">Beskrivning</label>
        <InputTextArea class="form-control" @bind-Value="newArticle.Description" />
        <ValidationMessage For="@(() => newArticle.Description)" class="text-danger" />
    </div>

    <div class="mb-3">
        <label class="form-label">Pris</label>
        <InputNumber class="form-control" @bind-Value="newArticle.Price" ParsingErrorMessage="Ange ett giltigt pris" />
        <ValidationMessage For="@(() => newArticle.Price)" class="text-danger" />
    </div>

    <div class="mb-3">
        <label class="form-label">Antal i lager</label>
        <InputNumber class="form-control" @bind-Value="newArticle.StockQuantity" ParsingErrorMessage="Ange ett giltigt antal" />
        <ValidationMessage For="@(() => newArticle.StockQuantity)" class="text-danger" />
    </div>

    <div class="mb-3">
        <label class="form-label">Min. lager</label>
        <InputNumber class="form-control" @bind-Value="newArticle.MinimumStock" ParsingErrorMessage="Ange ett giltigt antal" />
        <ValidationMessage For="@(() => newArticle.MinimumStock)" class="text-danger" />
    </div>

    <div class="mb-3">
        <label class="form-label">Lagringsplats</label>
        <InputText class="form-control" @bind-Value="newArticle.StorageLocation" />
        <ValidationMessage For="@(() => newArticle.StorageLocation)" class="text-danger" />
    </div>

    <div class="form-check mb-3">
        <InputCheckbox class="form-check-input" @bind-Value="newArticle.IsActive" />
        <label class="form-check-label">Aktiv artikel</label>
    </div>

    <button class="btn btn-success" type="submit" disabled="@isSaving">
        @if (isSaving)
        {
            <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
            <span>Sparar...</span>
        }
        else
        {
            <span>Skapa</span>
        }
    </button>
    <button class="btn btn-secondary ms-2" @onclick="Cancel">Avbryt</button>
</EditForm>

@if (!string.IsNullOrEmpty(errorMessage))
{
    <div class="alert alert-danger mt-3">
        @errorMessage
    </div>
}

@if (!string.IsNullOrEmpty(successMessage))
{
    <div class="alert alert-success mt-3">
        @successMessage
    </div>
}

@code {
    private CreateArticleDto newArticle = new CreateArticleDto
    {
        IsActive = true // default
    };
    private string errorMessage = string.Empty;
    private string successMessage = string.Empty;
    private bool isSaving = false;

    private async Task SaveArticle()
    {
        try
        {
            isSaving = true;
            StateHasChanged();
            var created = await ArticleService.CreateArticleAsync(newArticle);
            if (created != null)
            {
                successMessage = $"Artikel '{newArticle.Name}' har skapats framgångsrikt.";
                Navigation.NavigateTo("/articles");
            }
            else
            {
                errorMessage = "Kunde inte skapa artikel. Kontrollera att all data är korrekt.";
            }
        }
        catch (InvalidOperationException ex)
        {
            errorMessage = ex.Message;
        }
        catch (UnauthorizedAccessException)
        {
            errorMessage = "Du har inte behörighet att skapa artiklar.";
        }
        catch (Exception ex)
        {
            errorMessage = $"Ett oväntat fel inträffade: {ex.Message}";
        }
        finally
        {
            isSaving = false;
            StateHasChanged();
        }
    }

    private void Cancel()
    {
        Navigation.NavigateTo("/articles");
    }
}